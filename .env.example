# Copy to .env.local and fill in. Never commit real secrets.

# --- Database (Supabase) --------------------------------------------------------
# Supabase dashboard → Connect → Direct tab → "Transaction pooler" (port 6543), then add ?sslmode=require.
# Percent-encode reserved characters in the password, such as & # ? and spaces.
# Encode $ as %24 too: Next.js would otherwise read $word as a variable and change the password.
DATABASE_URL=postgresql://postgres.PROJECT-REF:PASSWORD@POOLER-HOST:6543/postgres?sslmode=require
# Optional, used only by `npm run db:migrate`: the "Session pooler" URL (port 5432), also with ?sslmode=require
# DATABASE_MIGRATION_URL=

# --- LLM ---------------------------------------------------------------------
# anthropic | openai | groq | mock. If unset: anthropic if ANTHROPIC_API_KEY is set,
# else openai if OPENAI_API_KEY is set, else groq if GROQ_API_KEY is set,
# else mock (offline, no key needed).
LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_MS=20000

# --- Security ------------------------------------------------------------------
# Requests per minute per IP to AI endpoints (create / regenerate)
RATE_LIMIT_AI_PER_MINUTE=10
# When both are set the whole app is protected with HTTP Basic Auth
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# --- Sentry (optional — disabled when no DSN) -----------------------------------
NEXT_PUBLIC_SENTRY_DSN=
# Source map upload at build time (Vercel): org/project slugs + auth token
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.2
