# Copy to .env.local and fill in. Never commit real secrets.

# --- Database (PostgreSQL / Supabase) ---------------------------------------
# Local:     postgres://inbox:inbox@localhost:5432/inbox
# Supabase:  Project → Connect → "Transaction pooler" (port 6543) for the app runtime
DATABASE_URL=postgres://inbox:inbox@localhost:5432/inbox
# Optional: direct / session pooler URL (port 5432) used only by `npm run db:migrate`
# DATABASE_MIGRATION_URL=

# --- LLM ---------------------------------------------------------------------
# anthropic | openai | mock. If unset: anthropic if ANTHROPIC_API_KEY is set,
# else openai if OPENAI_API_KEY is set, else mock (offline, no key needed).
LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
LLM_TIMEOUT_MS=20000

# --- Security ------------------------------------------------------------------
# Requests per minute per IP to AI endpoints (create / regenerate)
RATE_LIMIT_AI_PER_MINUTE=10
# When both are set the whole app is protected with HTTP Basic Auth
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# --- Sentry (optional — disabled when no DSN) -----------------------------------
NEXT_PUBLIC_SENTRY_DSN=
# Source map upload at build time (Vercel): org/project slugs + auth token
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.2
